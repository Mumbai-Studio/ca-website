# Collaborative Architecture · server settings for Apache and LiteSpeed (cPanel and most shared hosts)
# Written by tools/build.js: change server/redirects.txt or tools/build.js, then build again; do not edit this copy.

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
AddType image/webp .webp
AddType text/markdown .md
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddCharset utf-8 .md .txt .xml .json .js .css
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# one address for search engines: https, no www (only on the real domain, so a test address keeps working)
RewriteCond %{HTTP_HOST} ^www\.collaborativearchitecture\.com$ [NC]
RewriteRule ^ https://collaborativearchitecture.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^collaborativearchitecture\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://collaborativearchitecture.com%{REQUEST_URI} [R=301,L]

# closed to the web: the form handlers' private folder, and hidden files (but not /.well-known/, which certificates need)
RewriteRule ^_private(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# old addresses of the WordPress site (server/redirects.txt)
