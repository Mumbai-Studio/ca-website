# Collaborative Architecture · server settings for Apache and LiteSpeed (cPanel and most shared hosts)
# Written by tools/build.js: change server/redirects.txt or tools/build.js, then build again; do not edit this copy.

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
AddType image/webp .webp
AddType text/markdown .md
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddCharset utf-8 .md .txt .xml .json .js .css
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# one address for search engines: https, no www (only on the real domain, so a test address keeps working)
RewriteCond %{HTTP_HOST} ^www\.collaborativearchitecture\.com$ [NC]
RewriteRule ^ https://collaborativearchitecture.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^collaborativearchitecture\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://collaborativearchitecture.com%{REQUEST_URI} [R=301,L]

# copy protection (13 November 2026, tools/guard.js): site-copying tools and hidden (headless) browsers get 403 and the studio's
# name and addresses; search engines, AI crawlers and assistants (also any agent that signs its requests), SEO and speed tools
# and link previews always pass; the text files (robots.txt, sitemap.xml, llms.txt, feeds, Markdown copies) stay open to all
RewriteCond %{HTTP:Signature-Agent} .
RewriteRule ^ - [CO=ca-agent:1:collaborativearchitecture.com:1440:/:true:false]
RewriteCond %{REQUEST_URI} !(\.(txt|md|xml|json)$|^/403\.html$|^/\.well-known/)
RewriteCond %{HTTP:Signature-Agent} ^$
RewriteCond %{HTTP_USER_AGENT} !(Googlebot|Google-InspectionTool|GoogleOther|Google-Extended|Storebot-Google|AdsBot-Google|Mediapartners-Google|FeedFetcher-Google|Google-Read-Aloud|Google-Site-Verification|Google-CloudVertexBot|APIs-Google|Google-Safety|bingbot|BingPreview|MicrosoftPreview|msnbot|adidxbot|DuckDuckBot|DuckAssistBot|YandexBot|YandexRenderResourcesBot|YandexImages|Baiduspider|Sogou|360Spider|PetalBot|coccocbot|Applebot|SeznamBot|Yeti|NaverBot|Qwantbot|MojeekBot|archive\.org_bot|ia_archiver|GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|meta-externalagent|meta-externalfetcher|FacebookBot|Amazonbot|CCBot|Bytespider|GrokBot|xAI-Grok|Grok-DeepSearch|cohere-ai|MistralAI-User|YouBot|Chrome-Lighthouse|PTST|GTmetrix|Pingdom|SemrushBot|SiteAuditBot|AhrefsBot|AhrefsSiteAudit|Screaming\sFrog|Sitebulb|rogerbot|dotbot|MJ12bot|DataForSeoBot|serpstatbot|BLEXBot|Seobility|Lumar|deepcrawl|ContentKing|OncrawlBot|botify|W3C_Validator|W3C-checklink|Validator\.nu|UptimeRobot|StatusCake|facebookexternalhit|Facebot|LinkedInBot|Twitterbot|Pinterest|Slackbot|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|redditbot|Embedly|Iframely|Bingbot|Applebot-Extended|Sogou\sweb\sspider|coccocbot-web) [NC]
RewriteCond %{HTTP_USER_AGENT} (HTTrack|Wget|WebCopier|Cyotek|WebCopy|Teleport|Offline\sExplorer|OfflineExplorer|SiteSucker|WebZIP|WebStripper|WebReaper|BlackWidow|SiteSnagger|WebWhacker|Website\sExtractor|Website\sDownloader|Web\sDownloader|WebSauger|PageNest|Scrapy|craft-anything|CraftAnything|HeadlessChrome|PhantomJS|SlimerJS|Puppeteer|Playwright|Selenium) [NC]
RewriteRule ^ - [F,L]

# closed to the web: the form handlers' private folder, and hidden files (but not /.well-known/, which certificates need)
RewriteRule ^_private(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# old addresses of the WordPress site (server/redirects.txt)
# 26 November 2026 (Search Console, Pages report): old addresses Google still asks for (patch gsc1)
# feed links that once read "feeds/..." without the leading slash, so /news/press/ made /news/press/feeds/...
RewriteRule ^.+/feeds/(logs|news|press|projects)\.xml$ https://collaborativearchitecture.com/feeds/$1.xml [R=301,L]
RewriteRule ^en/?$ https://collaborativearchitecture.com/ [R=301,L]
RewriteRule ^portfolio/?$ https://collaborativearchitecture.com/work/ [R=301,L]
RewriteRule ^wp-content/uploads/2020/11/2020-AUG-MGS-ARCHITECTURE\.pdf$ https://collaborativearchitecture.com/press/features/2020-mgs-architecture-designing-peace-cooper-hewitt.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2020/11/2019-FEB-ARCHITECTURE-DESIGN\.pdf$ https://collaborativearchitecture.com/press/features/2019-02-architecture-and-design-global-dynamics.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2020/11/3\.-IO-July-16_Lalita-Mujib\.pdf$ https://collaborativearchitecture.com/press/features/2016-07-inside-outside-interview-with-the-principals.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2020/12/2015-JUL-FX\.pdf$ https://collaborativearchitecture.com/press/features/2015-07-fx-reflected-topography.pdf [R=301,L]
# the old WordPress search: /search/... is gone, and /?s=... goes to the home page without the query
RewriteRule ^search/ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)s=
RewriteRule ^$ https://collaborativearchitecture.com/? [R=301,L]

