# the form handlers: only contact.php, subscribe.php and vitals.php answer from the web; the settings files never do
<FilesMatch "^(lib|config|config\.sample|mailchimp|mailchimp\.sample|security|security\.sample)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
