# the form handlers: only contact.php and subscribe.php answer from the web
<FilesMatch "^(lib|config|config\.sample)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
